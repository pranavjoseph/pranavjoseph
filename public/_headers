/*
  # ❌ Hide server and hosting fingerprints
  Server: secure
  X-Powered-By:
  X-AspNet-Version:
  X-AspNetMvc-Version:
  X-Generator:
  X-NF-Request-ID:
  X-NF-Trace-ID:
  Via:
  CF-Cache-Status:
  Report-To:
  NEL:
  X-Runtime:

  # ❌ Remove ETag to reduce detection
  Etag:

  # ❌ Prevent exposing file types
  X-Content-Type-Options: nosniff

  # ❌ Remove CORS reflection
  Access-Control-Allow-Origin: *

  # ✔ Optional (but helps reduce fingerprinting)
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block

  # ❌ If you disabled HSTS in Cloudflare dashboard, keep this blank
  Strict-Transport-Security:
